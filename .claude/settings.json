{
  "permissions": {
    "deny": [
      "mcp__atlassian-olga__createConfluencePage",
      "mcp__atlassian-olga__updateConfluencePage",
      "mcp__atlassian-olga__createConfluenceFooterComment",
      "mcp__atlassian-olga__createConfluenceInlineComment",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.dev.vars)"
    ],
    "allow": [
